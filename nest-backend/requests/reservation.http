POST {{baseUrl}}/reservations
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "vehicleId": 99999,
  "slotId": 1,
  "startTime": "2024-01-15T10:00:00Z",
  "endTime": "2024-01-15T12:00:00Z",
  "entryTime": "2024-01-15T10:05:00Z"
}

### 27. Test Invalid Parking Slot ID
POST {{baseUrl}}/reservations
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "vehicleId": 1,
  "slotId": 99999,
  "startTime": "2024-01-15T10:00:00Z",
  "endTime": "2024-01-15T12:00:00Z",
  "entryTime": "2024-01-15T10:05:00Z"
}

### 28. Test Invalid Time Logic (Start >= End)
POST {{baseUrl}}/reservations
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "vehicleId": 1,
  "slotId": 1,
  "startTime": "2024-01-15T12:00:00Z",
  "endTime": "2024-01-15T10:00:00Z",
  "entryTime": "2024-01-15T10:05:00Z"
}

### 29. Test Invalid Entry Time (Before Start)
POST {{baseUrl}}/reservations
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "vehicleId": 1,
  "slotId": 1,
  "startTime": "2024-01-15T10:00:00Z",
  "endTime": "2024-01-15T12:00:00Z",
  "entryTime": "2024-01-15T09:55:00Z"
}

### 30. Test Invalid Exit Time (Before Entry)
PATCH {{baseUrl}}/reservations/1/checkout
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "exitTime": "2024-01-15T09:00:00Z",
  "totalAmount": 15.50,
  "paymentStatus": "PAID"
}

