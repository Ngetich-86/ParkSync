# Neon Database Configuration (Primary)
DATABASE_URL=postgresql://username:

# Local Development Database (Fallback - comment out when using Neon)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=supersecret
# DB_NAME=massnova-db

# Database Settings
DB_SYNC=true
DB_LOGGING=true

# Redis
REDIS_PASSWORD=redis_secret

# JWT
JWT_ACCESS_TOKEN_SECRET=
JWT_ACCESS_TOKEN_EXPIRES_IN=60m
JWT_REFRESH_TOKEN_SECRET=
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# Throttler
THROTTLER_TTL=6000
THROTTLER_LIMIT=100

# Application
PORT=5000

# Email Configuration
EMAIL_SENDER=your_email_address
EMAIL_PASSWORD=your_email_password

# Razorpay Configuration (Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=